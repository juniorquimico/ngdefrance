{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp@3.41.0"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY:-fc-injected-by-proxy}"
      }
    }
  }
}
